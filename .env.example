# Скопируйте в .env: cp .env.example .env
# .env читают сервис поиска и индексатор при запуске (python -m search_api / indexer).
# Переменные, уже заданные в окружении, .env не перекрывает.

# Энкодер — общий для индексатора и API: при смене модели переиндексировать
WINE_MODEL_ID=google/siglip2-so400m-patch16-512
WINE_DEVICE=cuda
WINE_DTYPE=float16
WINE_VRAM_LIMIT_GB=14
WINE_BATCH_SIZE=16
WINE_MODELS_DIR=./models

# Qdrant и сервис
WINE_QDRANT_URL=http://localhost:6333
WINE_COLLECTION=wines
WINE_API_HOST=127.0.0.1
WINE_API_PORT=8080

# OCR-переранжирование топ-20 (EasyOCR): +0,4 с, +2 ГБ VRAM
WINE_OCR_ENABLED=1

# VLM-реранкер (Qwen3-VL-4B) выбирает вино внутри топ-5: 1 — включить.
# Нужны веса: ./infra/fetch-vlm.sh (8,9 ГБ). +9 ГБ VRAM, +0,7–1,2 с на запрос.
# С VLM OCR почти не добавляет точности — его можно выключить (WINE_OCR_ENABLED=0),
# это лучший вариант по замерам: top-1 96,2%, p95 ≈ 1,6 с.
WINE_VLM_ENABLED=0
# WINE_VLM_TOP_K=5
# WINE_VLM_CANDIDATE_IMAGES=1
# WINE_VLM_QUERY_MAX_PIXELS=524288
# WINE_VLM_CANDIDATE_MAX_PIXELS=131072
# WINE_CATALOG_DIR=./data/catalog
