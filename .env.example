# Скопируйте в .env: cp .env.example .env
# .env читают docker compose (подставляет во все сервисы) и сервисы при нативном
# запуске (python -m search_api / embedder / indexer …). Переменные, уже заданные
# в окружении, .env не перекрывает.

# Энкодер SigLIP 2 — общий для embedder и индексатора: при смене модели переиндексировать
WINE_MODEL_ID=google/siglip2-so400m-patch16-512
WINE_DEVICE=cuda
WINE_DTYPE=float16
# лимит VRAM индексатора; у embedder свой — WINE_EMBEDDER_VRAM_LIMIT_GB (2,5 ГБ)
WINE_VRAM_LIMIT_GB=14
WINE_BATCH_SIZE=16
WINE_MODELS_DIR=./models

# Qdrant и сервис
WINE_QDRANT_URL=http://localhost:6333
WINE_COLLECTION=wines
WINE_API_HOST=0.0.0.0
WINE_API_PORT=8080

# VLM (Qwen3-VL-4B-FP8 в сервисе vllm) выбирает вино среди топ-5 векторного поиска
# и проверяет выбранное — на этом держится ответ «вина нет в каталоге». Веса:
# ./infra/fetch-vlm.sh (5,7 ГБ), ~12 ГБ VRAM у vllm. 0 — только картинка (слабее и
# без честного «не найдено»; так можно и без GPU для vLLM).
WINE_VLM_ENABLED=1
# Модель и доля видеокарты для vLLM (доля от всей карты, не от лимита 14 ГБ)
# WINE_VLLM_MODEL=Qwen3-VL-4B-Instruct-FP8
# WINE_VLLM_GPU_UTIL=0.5
# Таймауты к сервисам моделей: упавший сервис даёт быстрый отказ, а не ожидание;
# после сбоя сервис не вызывается UNAVAILABLE_COOLDOWN_S секунд
# WINE_CONNECT_TIMEOUT_S=2
# WINE_EMBEDDER_TIMEOUT_S=15
# WINE_VLLM_TIMEOUT_S=30
# WINE_UNAVAILABLE_COOLDOWN_S=10
# WINE_VLM_TOP_K=5
# WINE_VLM_CANDIDATE_IMAGES=1
# WINE_VLM_QUERY_MAX_PIXELS=524288
# WINE_VLM_CANDIDATE_MAX_PIXELS=131072
# WINE_CATALOG_DIR=./data/catalog

# Сколько вин отдают /v1/search и /v1/scan (варианты и аналоги в интерфейсе)
# WINE_TOP_K=10

# Решение «вино найдено / нет в каталоге» (/v1/scan, поле status в /v1/search).
# Подобраны на 99 размеченных фото, см. services/search-api/src/search_api/verdict.py
# WINE_ACCEPT_MIN_VERIFY_PROB=0.3
# WINE_ACCEPT_MAX_VLM_NONE_PROB=0.5
# WINE_ACCEPT_MIN_VLM_PROB=0.8
# без VLM:
# WINE_ACCEPT_MIN_IMAGE_SCORE=0.76
# WINE_ACCEPT_MIN_MARGIN=0.02

# Личный кабинет (сервис пользователей, services/user-service)
# Администратор достижений; пароль не задан — сгенерируется и попадёт в docker compose logs users
# WINE_ADMIN_LOGIN=admin@vino-svoe.local
# WINE_ADMIN_PASSWORD=
# PostgreSQL в compose (адрес сервис получает от compose)
# WINE_PG_USER=wines
# WINE_PG_PASSWORD=wines
# WINE_PG_DB=wines
# WINE_USERS_SESSION_DAYS=30
# 1 — cookie сессии только по https
# WINE_USERS_COOKIE_SECURE=0

# Отклики пользователей сканера («не то вино»)
# WINE_FEEDBACK_DIR=./data/feedback
# Как часто api сверяет каталог в памяти с Qdrant (новые вина без перезапуска), с
# WINE_CATALOG_REFRESH_S=60

# Синхронизация каталога с vino-svoe.ru (сервис catalog): расписание по умолчанию,
# дальше его меняет админ в /app/ → Управление → «Каталог»
# WINE_CATALOG_SYNC_AUTO=1
# сколько раз (TIMES) за период (PER: minute | hour | day | week | month), не чаще раза в минуту
# WINE_CATALOG_SYNC_TIMES=1
# WINE_CATALOG_SYNC_PER=day
# Выход в интернет только через прокси на 127.0.0.1 хоста — ретранслятор egress:
# COMPOSE_PROFILES=proxy
# WINE_SYNC_PROXY=http://host.docker.internal:7115
# WINE_EGRESS_TARGET=127.0.0.1:<порт прокси>
# Прокси доступен по обычному адресу — без egress:
# WINE_SYNC_PROXY=http://proxy.example:3128

# Логи: logs/<дата>/all.log (важное по всем сервисам) и logs/<дата>/services/<сервис>.log
# WINE_LOG_LEVEL=INFO
# 1 — писать каждый HTTP-запрос к сервисам (по умолчанию — только ошибки и медленные)
# WINE_LOG_REQUESTS=0
# WINE_LOGS_KEEP_DAYS=30
