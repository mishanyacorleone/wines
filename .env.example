# Скопируйте в .env: cp .env.example .env
# .env читают сервис поиска и индексатор при запуске (python -m search_api / indexer).
# Переменные, уже заданные в окружении, .env не перекрывает.

# Энкодер — общий для индексатора и API: при смене модели переиндексировать
WINE_MODEL_ID=google/siglip2-so400m-patch16-512
WINE_DEVICE=cuda
WINE_DTYPE=float16
WINE_VRAM_LIMIT_GB=14
WINE_BATCH_SIZE=16
WINE_MODELS_DIR=./models

# Qdrant и сервис
WINE_QDRANT_URL=http://localhost:6333
WINE_COLLECTION=wines
WINE_API_HOST=0.0.0.0
WINE_API_PORT=8080

# VLM (Qwen3-VL-4B) выбирает вино среди топ-5 векторного поиска и проверяет
# выбранное — на этом держится ответ «вина нет в каталоге». Веса: ./infra/fetch-vlm.sh
# (8,9 ГБ), ~10 ГБ VRAM. 0 — только картинка (слабее и без честного «не найдено»).
WINE_VLM_ENABLED=1
# WINE_VLM_TOP_K=5
# WINE_VLM_CANDIDATE_IMAGES=1
# WINE_VLM_QUERY_MAX_PIXELS=524288
# WINE_VLM_CANDIDATE_MAX_PIXELS=131072
# WINE_CATALOG_DIR=./data/catalog

# Сколько вин отдают /v1/search и /v1/scan (варианты и аналоги в интерфейсе)
# WINE_TOP_K=10

# Решение «вино найдено / нет в каталоге» (/v1/scan, поле status в /v1/search).
# Подобраны на 99 размеченных фото, см. services/search-api/src/search_api/verdict.py
# WINE_ACCEPT_MIN_VERIFY_PROB=0.3
# WINE_ACCEPT_MAX_VLM_NONE_PROB=0.5
# WINE_ACCEPT_MIN_VLM_PROB=0.8
# без VLM:
# WINE_ACCEPT_MIN_IMAGE_SCORE=0.76
# WINE_ACCEPT_MIN_MARGIN=0.02

# Мобильный сканер на /app/ и отклики пользователей
# WINE_WEB_ENABLED=1
# WINE_FEEDBACK_DIR=./data/feedback
